<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-feature android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:name=".AgriAlertApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgriAlert">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- File provider for camera photo capture -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.agrialert.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Entry point -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AgriAlert">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Map Picker shared screen -->
        <activity
            android:name=".ui.farmer.MapPickerActivity"
            android:exported="false"
            android:label="Pin Location" />

        <!-- Shared auth screens -->
        <activity android:name=".ui.LoginActivity"
            android:exported="false"/>
        <activity android:name=".ui.RegisterActivity"
            android:exported="false"/>

        <!-- Shared screens -->
        <activity android:name=".ui.farmer.AlertDetailActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.NotificationsActivity"
            android:exported="false"/>

        <!-- Farmer screens -->
        <activity android:name=".ui.farmer.FarmerDashboardActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.ReportFormActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.ReportHistoryActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.FarmerReportDetailActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.AlertsListActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.FarmerProfileActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.KnowledgeBaseActivity"
            android:exported="false"/>
        <activity android:name=".ui.farmer.ArticleDetailActivity"
            android:exported="false"/>

        <!-- Vet officer screens -->
        <activity android:name=".ui.vet.VetDashboardActivity"
            android:exported="false"/>
        <activity android:name=".ui.vet.VetReportListActivity"
            android:exported="false"/>
        <activity android:name=".ui.vet.VetReportDetailActivity"
            android:exported="false"/>
        <activity android:name=".ui.vet.SendAlertActivity"
            android:exported="false"/>
        <activity android:name=".ui.vet.AlertsHistoryActivity"
            android:exported="false"/>
        <activity android:name=".ui.vet.VetProfileActivity"
            android:exported="false"/>

        <!-- Admin screens -->
        <activity android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.UserManagementActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.UserDetailActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.AdminReportListActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.AdminReportDetailActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.AdminStatsActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.AdminAlertsListActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.AdminNotificationActivity"
            android:exported="false"/>
        <activity android:name=".ui.admin.AdminProfileActivity"
            android:exported="false"/>

    </application>

</manifest>
